# =========================
# SERVER
# =========================
SITE_DOMAIN=http://localhost:8080
SECRET_KEY=super-secret-key-change-me
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# =========================
# DATABASE (MySQL)
# =========================
# Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=best_habit
MYSQL_USER=besthabit
MYSQL_PASSWORD=besthabitpw
DB_CONNECTION_STR=username:password@tcp(127.0.0.1:3306)/best_habit?charset=utf8mb4&parseTime=True&loc=Local

# =========================
# EMAIL (GMAIL SMTP)
# =========================
SENDER_APP_NAME=BestHabit
SENDER_EMAIL_ADDRESS=your_email@gmail.com
SENDER_APP_PW=your_app_password_here

# =========================
# GOOGLE OAUTH
# =========================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# =========================
# AWS S3 (UPLOAD PROVIDER)
# =========================
S3BucketName=your_bucket_name
S3Region=ap-southeast-1
S3ApiKey=your_aws_access_key
S3Secret=your_aws_secret_key
S3Domain=https://your_bucket_name.s3.amazonaws.com

# =========================
# FIREBASE (PUSH NOTIFICATION)
# =========================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id
